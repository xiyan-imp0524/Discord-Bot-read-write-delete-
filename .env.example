# Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here

# Comma-separated server (guild) IDs where the bot is allowed
GUILD_IDS=your_server_id_here

# Comma-separated Discord user IDs allowed to run commands
ALLOWED_USERS=your_discord_user_id_here

# Comma-separated user IDs in the notification group (must also be in ALLOWED_USERS).
# When one user messages another (via @mention, reply, /tell, or bot DM), only the recipient is notified.
# MESSAGE_CONTENT_INTENT=true
NOTIFY_USERS=your_discord_user_id_here,another_user_id_here

# Comma-separated user IDs who get automatic replies when /auto is enabled
AUTO_REPLY_USERS=your_discord_user_id_here,another_user_id_here

# Optional: smarter AI replies (uses OpenAI). Without this, built-in natural replies are used.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# CONVERSATION_MEMORY_LIMIT=50
# CONVERSATION_API_LIMIT=30
# CONVERSATION_LOG_DIR=logs
